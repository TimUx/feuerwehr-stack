# Installer-managed values. Copying this file alone does not install the stack.
STACK_ROOT=/srv/apps/feuerwehr
COMPOSE_PROFILES=data,keycloak,matrix,onlyoffice,grav,proxy
PROXY_MODE=own
TRAEFIK_NETWORK=
ENABLE_PROXY_ROUTES=true
TRAEFIK_CERT_RESOLVER=feuerwehr
BASE_DOMAIN=feuerwehr.example.de
ACME_EMAIL=admin@example.de
ACME_CHALLENGE=http
ACME_DNS_PROVIDER=
ACME_DNS_ENV_FILE=
KEYCLOAK_HOST=id.feuerwehr.example.de
OPENWEHR_HOST=wehr.feuerwehr.example.de
OPENWEHR_ADMIN_EMAILS=
MATRIX_HOST=matrix.feuerwehr.example.de
ELEMENT_HOST=chat.feuerwehr.example.de
ONLYOFFICE_HOST=docs.feuerwehr.example.de
GRAV_HOST=www.feuerwehr.example.de
MATRIX_SERVER_NAME=matrix.feuerwehr.example.de
MATRIX_FEDERATION=false
VPN_BACKEND_IP=
ENABLED_APPS=keycloak,openwehr
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_PORT=18084
OPENWEHR_PORT=18080
MATRIX_PORT=18008
ELEMENT_PORT=18081
ONLYOFFICE_PORT=18082
GRAV_PORT=18083
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Feuerwehr
