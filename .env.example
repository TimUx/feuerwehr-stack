# Installer-managed values. Copying this file alone does not install the stack.
STACK_ROOT=/srv/apps/feuerwehr
COMPOSE_PROFILES=data,keycloak,wehrportal,matrix,onlyoffice,drupal,proxy
PROXY_MODE=own
# compose oder swarm (swarm benötigt PROXY_MODE=same-host und einen Swarm-Manager)
DEPLOY_MODE=compose
TRAEFIK_NETWORK=
ENABLE_PROXY_ROUTES=true
TRAEFIK_CERT_RESOLVER=feuerwehr
TRAEFIK_MIDDLEWARES=
BASE_DOMAIN=feuerwehr.example.de
ACME_EMAIL=admin@example.de
ACME_CHALLENGE=http
ACME_DNS_PROVIDER=
ACME_DNS_ENV_FILE=
KEYCLOAK_HOST=login.feuerwehr.example.de
WEHRPORTAL_HOST=portal.feuerwehr.example.de
WEHRPORTAL_ADMIN_EMAILS=
# Derived from app selection by the installer; OIDC settings are stored in the portal database.
WEHRPORTAL_OIDC_ENABLED=false
WEHRPORTAL_OIDC_FORCE_DISABLED=false
WEHRPORTAL_IMAGE_TAG=latest
POSTGRES_IMAGE=postgres:latest
MATRIX_HOST=matrix.feuerwehr.example.de
FLUFFYCHAT_HOST=messenger.feuerwehr.example.de
ONLYOFFICE_HOST=docs.feuerwehr.example.de
DRUPAL_HOST=www.feuerwehr.example.de
DRUPAL_ADMIN_EMAIL=admin@feuerwehr.example.de
# Set by the installer: true only when Drupal and Keycloak are both selected.
DRUPAL_OIDC_ENABLED=false
KEYCLOAK_REALM=feuerwehr
MATRIX_SERVER_NAME=matrix.feuerwehr.example.de
MATRIX_FEDERATION=false
# Derived from app selection: Matrix + Keycloak.
MATRIX_OIDC_ENABLED=false
VPN_BACKEND_IP=
ENABLED_APPS=keycloak,wehrportal
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_PORT=18084
WEHRPORTAL_PORT=18080
MATRIX_PORT=18008
FLUFFYCHAT_PORT=18081
ONLYOFFICE_PORT=18082
DRUPAL_PORT=18083
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Feuerwehr

# Ressourcenlimits (Gesamtbudget des Stacks; der Installer verteilt es auf die Dienste
# und schreibt MEM_<DIENST>/CPU_<DIENST> in die .env)
STACK_MAX_MEMORY_MB=8192
STACK_MAX_CPUS=4
